# Generated runtime/test state — must never be shipped or captured in review snapshots
# Ephemeral audit/verification work areas (.tmp-review-*, .tmp-verify-*,
# .tmp-count-*, .tmp-artifact*, .tmp-scratch): read-only inventory only, never
# delete blindly — some may hold another agent's active verification evidence.
.tmp-*/
