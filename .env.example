# Kontrol example environment.
# Copy to a private env file such as ~/.kontrol/kontrol.env or .env, then edit.
# Keep secret-bearing files mode 0600.

HOST=127.0.0.1
PORT=7676

# Comma-separated local roots that MCP workspaces may open.
KONTROL_ALLOWED_ROOTS=$HOME/projects,$HOME/work

# Public origin for OAuth/public tunnel mode. Do not include /mcp.
# KONTROL_PUBLIC_BASE_URL=https://kontrol.example.com
# Stable-beta hosted qualification uses KONTROL_AUTH_MODE=oauth and this
# non-loopback HTTPS origin. For OpenAI Secure MCP Tunnel qualification, use
# KONTROL_AUTH_MODE=tunnel and the loopback MCP origin instead. The two profiles
# have different trust boundaries and are qualified in separate runs.
# KONTROL_BETA_SOAK_TRANSPORT=public_https
# KONTROL_BETA_SOAK_URL=https://kontrol.example.com

# Optional supervisor canary for the externally reachable MCP route. The
# authorization file contains only the header value and must be mode 0600.
# KONTROL_MCP_CANARY_URL=https://kontrol.example.com
# KONTROL_MCP_CANARY_AUTH_FILE=$HOME/.kontrol/mcp-canary.authorization

# Auth mode:
# - oauth: public/reverse-proxy deployments with owner approval
# - tunnel: loopback-only OpenAI Secure MCP Tunnel deployments
KONTROL_AUTH_MODE=oauth

# In tunnel mode the managed tunnel injects this into MCP target requests so
# the WebUI has reviewer authority. Defaults to KONTROL_ACP_REVIEWER_SECRET.
# KONTROL_TUNNEL_REVIEWER_SECRET=<32+ chars, keep private>

# Owner password for non-interactive/env-driven OAuth deployments.
# Generate with: openssl rand -base64 32
# KONTROL_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# KONTROL_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# KONTROL_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# KONTROL_OAUTH_SCOPES=kontrol
# KONTROL_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1

# Legacy tunnel token. Kontrol tunnel mode intentionally does not add a second
# MCP bearer gate; authentication belongs to the Secure MCP Tunnel. Keep this
# unset. Existing values are ignored for compatibility and are never forwarded.
# KONTROL_TUNNEL_TOKEN=change-me-to-a-long-random-secret

# Bounded MCP request admission.
# KONTROL_MCP_MAX_INFLIGHT=32
# KONTROL_MCP_MAX_INFLIGHT_PER_SESSION=8
# KONTROL_MCP_MAX_QUEUE=128
# KONTROL_MCP_MAX_QUEUE_PER_SESSION=16
# KONTROL_MCP_ADMISSION_TIMEOUT_MS=120000
# KONTROL_MCP_INTERACTIVE_ADMISSION_TIMEOUT_MS=8000
# KONTROL_MCP_SSE_HEARTBEAT_MS=15000
# Maximum time an SSE response may remain backpressured before only that response is terminated.
# KONTROL_MCP_SSE_MAX_STALL_MS=30000
# Grace period for active MCP handlers before shutdown remains fenced with stores open.
# KONTROL_MCP_SHUTDOWN_DRAIN_MS=30000
# Grace after request cancellation before an unsettled SDK handler is classified as STUCK.
# KONTROL_MCP_OPERATION_CANCEL_GRACE_MS=5000
# KONTROL_MCP_EXECUTION_TIMEOUT_MS=1800000  # ordinary MCP calls; waiters/approvals are exempt
# KONTROL_POLICY_APPROVAL_TIMEOUT_MS=86400000  # stale-card backstop; approvals remain blocking
# KONTROL_POLICY_DIRECT_APPROVAL_TTL_MS=600000  # human decision window for direct MCP approvals
# KONTROL_MCP_REQUEST_DEADLINE_MS=120000  # legacy alias for admission timeout
# Long-poll waiters use a separate admission budget from normal tool calls.
# KONTROL_MCP_MAX_WAITERS=64
# KONTROL_MCP_MAX_WAITERS_PER_SESSION=2
# KONTROL_MCP_MAX_WAITER_QUEUE=64
# KONTROL_MCP_UNUSED_SESSION_IDLE_MS=600000
# Require a host's exact registered tools/list catalog acknowledgement before tool calls.
# Enable after the connected MCP host implements docs/mcp-tool-catalog-ack.md.
# KONTROL_MCP_REQUIRE_TOOL_CATALOG_ACK=false
# KONTROL_MCP_EPHEMERAL_SESSION_IDLE_MS=86400000
# KONTROL_MCP_REUSABLE_SESSION_IDLE_MS=86400000
# KONTROL_MCP_SESSION_REAPER_INTERVAL_MS=15000
# KONTROL_MCP_LOGICAL_CONTINUITY_RETENTION_MS=259200000
# KONTROL_MCP_SESSION_MAX_PER_CLIENT=20
# KONTROL_MCP_SESSION_SOFT_CAP=150
# KONTROL_MCP_SESSION_HARD_CAP=200

# Optional Host header allowlist override. Avoid "*" outside local debugging.
# KONTROL_ALLOWED_HOSTS=localhost,127.0.0.1,kontrol.example.com

# Tool and widget surface.
KONTROL_TOOL_MODE=minimal
KONTROL_WIDGETS=changes
KONTROL_DEV_WORKSPACE_APP_SMOKE=0

# State and managed worktrees.
# KONTROL_STATE_DIR=$HOME/.local/share/kontrol
# KONTROL_WORKTREE_ROOT=$HOME/.kontrol/worktrees

# Skills are enabled by default. Set to 0 to hide them.
# KONTROL_SKILLS=1
# KONTROL_AGENT_DIR=$HOME/.codex
# KONTROL_SKILL_PATHS=$HOME/.agents/skills,$HOME/.claude/skills

# Logging.
KONTROL_LOG_LEVEL=info
KONTROL_LOG_FORMAT=json
KONTROL_LOG_REQUESTS=1
KONTROL_LOG_ASSETS=0
KONTROL_LOG_TOOL_CALLS=1
KONTROL_LOG_SHELL_COMMANDS=0
# KONTROL_TRUST_PROXY=1                   # hop count of trusted proxies, or "loopback"; unset = ignore forwarded headers

# ACP control plane and adapter secrets.
# Secrets must be >=32 chars of high entropy and pairwise distinct.
# KONTROL_ACP_ENABLED=1
# KONTROL_ACP_SHARED_SECRET=<legacy compatibility mode only; 32+ chars>
# KONTROL_ACP_AGENT_SECRET=<worker credential, 32+ chars, distinct>
# KONTROL_ACP_REVIEWER_SECRET=<reviewer/WebUI credential, 32+ chars, distinct>
# KONTROL_ACP_ADAPTER_SECRET=<outbound adapter credential, 32+ chars, distinct>
# KONTROL_ACP_AGENTS=cli-coding-agent=http://127.0.0.1:9877,hermes-agent=http://127.0.0.1:9911
# KONTROL_ACP_URL=http://127.0.0.1:7676/acp

# Worker bridge used inside CLI-agent MCP config.
# KONTROL_BRIDGE_URL=http://127.0.0.1:7676/mcp
# KONTROL_BRIDGE_ENV=$HOME/.kontrol/kontrol.env

# CRUSH adapter.
# ACP_AGENT_BIN=crush
# CRUSH_BIN=crush
# ACP_ADAPTER_PORT=9877
# ACP_ADAPTER_REPLAY_STORE=$KONTROL_STATE_DIR/adapters/crush/replay.json
# KONTROL_CRUSH_OWNED_PROCESSES=$KONTROL_STATE_DIR/adapters/crush/owned-processes.json
# KONTROL_CRUSH_TERMINAL_SPOOL=$KONTROL_STATE_DIR/adapters/crush/terminal-spool.json

# Hermes native adapter.
# The adapter auto-detects the Hermes Python interpreter from the `hermes`
# binary's shebang and realpath. Override only if auto-detection fails.
# HERMES_BIN=hermes
# HERMES_AGENT_ROOT=/path/to/hermes-agent
# HERMES_NATIVE_PYTHON=/path/to/hermes-agent/.venv/bin/python
# HERMES_ACP_ADAPTER_PORT=9911
# START_HERMES_ADAPTER=auto   # auto (default) | true | false
# KONTROL_HERMES_DEADMAN_IDLE_MS=300000  # idle watchdog when no child operation is known
# KONTROL_HERMES_MAX_RUN_SECONDS=7200     # absolute run ceiling, including quiet tool work
# KONTROL_HERMES_OWNED_PROCESSES=$KONTROL_STATE_DIR/adapters/hermes/owned-processes.json
# KONTROL_HERMES_TERMINAL_SPOOL=$KONTROL_STATE_DIR/adapters/hermes/terminal-spool.json

# Long-lived component supervision and deployment gates.
# KONTROL_TUNNEL_PROFILE=sample_mcp_with_dcr
# KONTROL_TUNNEL_ID=tunnel_...  # override a profile's stale registration
# KONTROL_TUNNEL_DOCTOR=true  # validate the same tunnel args before launch
# KONTROL_SUPERVISOR_INTERVAL_MS=5000
# KONTROL_SUPERVISOR_MAX_INFLIGHT=4       # unrelated missions may progress concurrently
# KONTROL_VERIFY_MAX_INFLIGHT=3           # bounded parallel read-only criterion checks
# KONTROL_CRUSH_STUCK_IDLE_MS=3600000     # CRUSH stuck detector: zero-output idle treated as suspect and terminated after this window
# KONTROL_CRUSH_MAX_RUN_MS=86400000       # CRUSH absolute emergency ceiling regardless of activity
# KONTROL_CRUSH_TERMINATE_GRACE_MS=5000   # SIGTERM->SIGKILL grace when terminating a stuck run
# KONTROL_ACP_DISPATCH_TIMEOUT_MS=300000   # adapter acceptance handshake; run lifetime is supervised separately
# KONTROL_ACP_TERMINAL_SPOOL=$KONTROL_STATE_DIR/adapters/crush/terminal-spool.json  # legacy CRUSH spool override
# KONTROL_STARTUP_PROFILE=dev-fast        # dev-fast | normal | release preflight depth for start-all.sh
# KONTROL_POLICY_MODE=allow               # explicit global trust posture: allow|deny|ask (replaces the secure baseline)
# KONTROL_POLICY_TOOL_BASH=allow          # per-tool overrides. Secure baseline when unset: bash/write/edit/apply_patch=ask, read tools=allow
# KONTROL_POLICY_PATH_RULES='[{"pattern":"/etc/ssh/**","mode":"deny"}]'  # structured file tools only; shell needs its own bash rule
# KONTROL_OPERATIONAL_UAT=false  # true runs a disposable real-agent mission
# KONTROL_UAT_WORKSPACE=$PWD/.kontrol-uat
# KONTROL_VERIFY_SANDBOX=false   # require Bubblewrap for unattended verification
# KONTROL_BWRAP=/usr/bin/bwrap   # optional explicit Bubblewrap path
# KONTROL_READ_ONLY_NETWORK_POLICY=disabled # disabled by default for scheduled ACP sandboxes; host explicitly shares host networking. Hermes bounded writes require host until a local IPC transport is available inside the isolated namespace.
# KONTROL_CHILD_ENV_ALLOWLIST=SSH_AUTH_SOCK,HTTP_PROXY,HTTPS_PROXY,NO_PROXY  # additional non-secret child env names
# KONTROL_VERIFY_TOOLCHAIN_PATHS=/home/me/.nvm/versions/node/v22.19.0       # read-only sandbox toolchain mount
# KONTROL_WEBHOOKS=false          # outbound ACP webhooks are opt-in
# KONTROL_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# KONTROL_RELEASE_MODE=false     # refuse dirty source unless explicitly overridden
# KONTROL_ALLOW_DIRTY_RELEASE=false
# KONTROL_DIAGNOSTICS_SECRET=change-me-to-a-long-random-secret

# Harpoon is not required for KONTROL's loopback MCP target. Keep loopback
# auto-registration disabled so local http:// OAuth discovery URLs are not
# treated as HTTPS Harpoon targets.
# KONTROL_HARPOON_INCLUDE_LOOPBACK=false

# ---------------------------------------------------------------------------
# Optional PEER integration (OFF by default). Lets an independently
# authenticated remote peer (primary use case: Meta's hosted consumer Muse at
# muse.ai) call a scoped subset of Kontrol MCP tools. See
# docs/peer-integration.md for the full contract.
#
# All KONTROL_PEER_* variables are ignored unless KONTROL_PEER_ENABLED=1.
# With the feature off, no peer listener exists and the main MCP listener
# (OAuth/tunnel) is unchanged. Peers are NOT reviewers and NOT workers.
#
# NOTE: Only the read-only inspection surface (workspace:inspect) is
# implemented in this milestone. propose_patch/run_bounded and the job:*
# capabilities (C2) and any C3 hosted-Muse activation are reserved follow-on
# milestones; do not rely on them yet.
#
# KONTROL_PEER_ENABLED=1
# Interface to bind (default 127.0.0.1). Wildcard binds (0.0.0.0, ::, *) are
# rejected. Use a specific tailnet interface IP (e.g. a 100.x.y.z Tailscale
# address) to expose only on the tailnet.
# KONTROL_PEER_BIND_HOST=100.64.0.1
# Required when enabled; must differ from the main PORT (default 7676).
# KONTROL_PEER_PORT=7677
# Required when enabled; absolute path to an operator-owned JSON credential
# registry. File permissions must be 0600 or 0400 (group/other-readable files
# are refused at startup).
# KONTROL_PEER_CREDENTIAL_FILE=$HOME/.kontrol/peers.json
# Cap on concurrent peer MCP sessions.
# KONTROL_PEER_MAX_ACTIVE_SESSIONS=8
# Reserved for the outbound job protocol (C2); not yet active.
# KONTROL_PEER_MAX_CLAIMED_JOBS=8
# Per-request body limit on the peer listener.
# KONTROL_PEER_REQUEST_BYTES_LIMIT=1048576

# ---------------------------------------------------------------------------
# Optional INGRESS profiles (PR-A, OFF by default). Declarative description of
# external origins that are expected to reach Kontrol listeners. Wiring into
# live listeners arrives later; today this is parsed, validated, and exposed on
# the config object only. Unset stays bit-identical to the previous behavior.
#
# KONTROL_INGRESS_PROFILES is a strict JSON array of profiles with EXACTLY
# these fields (unknown fields are rejected):
#   id             unique, [A-Za-z0-9._-]{1,64}
#   kind           tailscale_serve | tailscale_funnel | https_bridge | secure_mcp_tunnel
#   audience       peer | owner_public
#   externalOrigin absolute https origin (serve/funnel/bridge); tunnel may be any origin
#   target         peer_listener | public_oauth_listener | secure_tunnel_listener
#   enabled        required boolean (no implicit enable)
#   managedByKontrol  optional, default false (observation only)
#   allowedHosts   exact FQDNs, never wildcards; required nonempty when enabled
#   proxyPeerIps   optional exact IPv4/IPv6 literals (no CIDR) of trusted adjacent proxies
#
# Rules: enabled owner_public profiles must equal the canonical publicBaseUrl
# origin (disabled standby profiles are exempt); tailscale serve/funnel cannot
# share a tailnet node+port; funnel ports are 443/8443/10000 only;
# public_oauth_listener targets require KONTROL_AUTH_MODE=oauth.
# KONTROL_INGRESS_PROFILES=[{"id":"serve-1","kind":"tailscale_serve","audience":"peer","externalOrigin":"https://node.tail-scale.ts.net:8443","target":"peer_listener","enabled":false,"allowedHosts":["node.tail-scale.ts.net:8443"]}]
